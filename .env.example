# Copy to .env.local for local dev (never commit real values).
# Each Vercel environment gets its OWN database so staging/dev votes
# never touch prod MMR, ratings, or W/L:
#   prod branch    -> Production env  -> prod Postgres
#   staging branch -> Preview env     -> staging Postgres
#   dev branch     -> Development env -> dev Postgres (or unset = localStorage mode)

# Unset/empty = localStorage-only mode (safe default for local dev).
POSTGRES_URL=""
